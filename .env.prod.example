# Modelo do .env.prod (servidor). Não preencha à mão os segredos: rode
#   python3 scripts/gerar-env-prod.py
# que copia este arquivo para .env.prod com senhas/tokens aleatórios novos.
# .env.prod NUNCA vai para o git.

# --- Endereço público -------------------------------------------------
# Domínio com DNS (registro A) apontando para o IP do servidor.
DOMINIO=laivy.exemplo.com.br
# E-mail para o Let's Encrypt avisar sobre o certificado HTTPS.
EMAIL_CERTIFICADO=voce@exemplo.com

# --- Banco (gerados pelo script) --------------------------------------
DB_NAME=sistema_esportivo
DB_PASSWORD=
DB_APP_USER=laivy
DB_APP_PASSWORD=

# --- Sessão e integração com o n8n (gerados pelo script) ---------------
JWT_SECRET=
JWT_EXPIRATION=28800000
N8N_TOKEN=
N8N_ENCRYPTION_KEY=

# --- E-mail (obrigatório em produção) -----------------------------------
# Envia login/senha dos atletas cadastrados pela IA.
# Brevo: https://app.brevo.com/settings/keys/smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM=
