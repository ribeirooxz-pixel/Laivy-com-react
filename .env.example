# Ambiente de DESENVOLVIMENTO (docker-compose.yml). Para servidor use .env.prod.example.
# Copie para .env e preencha os valores reais. .env nunca deve ir para o git.

DB_NAME=sistema_esportivo
DB_PASSWORD=troque-esta-senha
# Usuário do MySQL usado pela aplicação (não use root). Gere tudo com:
#   python3 scripts/rotacionar-segredos.py
DB_APP_USER=laivy
DB_APP_PASSWORD=troque-esta-senha-tambem

JWT_SECRET=troque-este-segredo-para-algo-longo-e-aleatorio
JWT_EXPIRATION=28800000

N8N_TOKEN=troque-este-token

# SMTP para enviar o login/senha dos atletas cadastrados pela IA.
# Deixe comentado para usar o Mailpit local (http://localhost:8025).
# Brevo: https://app.brevo.com/settings/keys/smtp
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=seu-login@smtp-brevo.com
# SMTP_PASSWORD=sua-chave-smtp
# SMTP_AUTH=true
# SMTP_STARTTLS=true
# MAIL_FROM=remetente-verificado-no-brevo@exemplo.com
